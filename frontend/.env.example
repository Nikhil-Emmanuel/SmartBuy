# Copy to .env.local for local development.

# FastAPI base URL. Leave blank in dev to use the Vite proxy (see vite.config.ts).
VITE_API_BASE_URL=http://localhost:8000

# Serve every screen from recorded fixtures instead of the live API.
# Run `python -m scripts.capture_fixtures` in backend/ to refresh them.
VITE_USE_MOCKS=false

# Optional: pre-fill the admin dashboard's token field for local use.
# Never commit a real token here -- this file is an example only.
VITE_ADMIN_TOKEN=
