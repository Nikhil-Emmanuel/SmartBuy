# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Databases
*.db
*.sqlite
*.sqlite3

# Node
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Data — large raw datasets stay out of git
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
ml/data/*
!ml/data/.gitkeep
*.csv.gz
*.parquet
*.pkl
*.joblib
*.npy
*.faiss

# Committed on purpose: the curated demo catalog is small and the demo depends on it
!data/products/*.json
!data/products/*.csv

# ML artifacts
ml/models/*
!ml/models/.gitkeep
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
