# ─── Copy to backend/.env and fill in. NEVER commit the real .env. ───

# Database — SQLite locally, Postgres (Neon) in production
DATABASE_URL=sqlite:///./smartbuy.db
# DATABASE_URL=postgresql+psycopg://user:pass@host/dbname?sslmode=require

# LLM — Google Gemini
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_TIMEOUT_SECONDS=12
LLM_MAX_RETRIES=1

# Feature flags
ENABLE_LLM_REQUIREMENT_AUGMENT=false
ENABLE_COLLABORATIVE_FILTERING=false
USE_DETERMINISTIC_FALLBACK=true

# App
SECRET_KEY=change-me-in-production
ADMIN_TOKEN=change-me-too
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=60

# Ranking (overrides backend/app/config/ranking.yaml when set)
# RANKING_WEIGHTS_PATH=app/config/ranking.yaml

# ─── frontend/.env.local ───
# VITE_API_BASE_URL=http://localhost:8000
# VITE_USE_MOCKS=false
