# ─── Copy to backend/.env and fill in. NEVER commit the real .env. ───

# Database — SQLite locally, Postgres (Neon) in production
DATABASE_URL=sqlite:///./smartbuy.db
# DATABASE_URL=postgresql+psycopg://user:pass@host/dbname?sslmode=require

# LLM — Google Gemini
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_TIMEOUT_SECONDS=12
LLM_MAX_RETRIES=1

# Feature flags -- NOT WIRED UP.
# All three are declared in app/core/config.py and read by no code. They are
# placeholders for features that were designed and never built. Changing them
# has no effect; they are kept only so the config shape does not churn.
#   ENABLE_LLM_REQUIREMENT_AUGMENT -- the LLM never adds requirements (ADR-002)
#   ENABLE_COLLABORATIVE_FILTERING -- there is no CF implementation
#   USE_DETERMINISTIC_FALLBACK     -- the fallback is unconditional; setting
#                                     this to false will NOT disable it
ENABLE_LLM_REQUIREMENT_AUGMENT=false
ENABLE_COLLABORATIVE_FILTERING=false
USE_DETERMINISTIC_FALLBACK=true

# App
SECRET_KEY=change-me-in-production
ADMIN_TOKEN=change-me-too
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=60

# Ranking (overrides backend/app/config/ranking.yaml when set)
# RANKING_WEIGHTS_PATH=app/config/ranking.yaml

# ─── frontend/.env.local ───
# VITE_API_BASE_URL=http://localhost:8000
# VITE_USE_MOCKS=false
