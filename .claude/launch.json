{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "smartbuy-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--host", "127.0.0.1"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "smartbuy-backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--port", "8000", "--app-dir", "backend"],
      "port": 8000
    }
  ]
}
